# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit.
# PowerShell: Copy-Item .env.example .env

# PostgreSQL (tài khoản quản trị, dùng chung cho 4 database)
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=change_me

# Kafka KRaft cluster ID. Sinh mới bằng:
# docker run --rm apache/kafka:4.1.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=change_me
