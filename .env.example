# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit.
# PowerShell: Copy-Item .env.example .env

# PostgreSQL (tài khoản quản trị, dùng chung cho 4 database)
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=change_me

# Kafka KRaft cluster ID. Sinh mới bằng:
# docker run --rm apache/kafka:4.1.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=change_me

# JWT secret dùng chung cho MỌI service khi chạy bằng Docker (truyền vào container dưới tên Jwt__Secret).
# Phải >= 32 byte. Nên dùng cùng giá trị với Jwt:Secret trong user-secrets để token local và Docker dùng chung được.
# Sinh mới (PowerShell):
# $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change_me_to_a_random_string_at_least_32_bytes
