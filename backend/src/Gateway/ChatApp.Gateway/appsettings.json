{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "groups": {
        "ClusterId": "group",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/groups/{**catch-all}" }
      },
      "chat-api": {
        "ClusterId": "chat",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "chat-hub": {
        "ClusterId": "chat",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/chat/{**catch-all}" }
      },
      "notifications-api": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "notifications-hub": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5001" } }
      },
      "group": {
        "Destinations": { "d1": { "Address": "http://localhost:5002" } }
      },
      "chat": {
        "Destinations": { "d1": { "Address": "http://localhost:5080" } }
      },
      "notification": {
        "Destinations": { "d1": { "Address": "http://localhost:5004" } }
      }
    }
  }
}
