        </mxCell>
        <mxCell id="label-0" value="Triển khai local theo mã nguồn · Mode Chat được chọn: Kubernetes kind · Có chế độ Compose thay thế" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontColor=#5B6E82;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
